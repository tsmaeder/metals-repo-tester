{
  "name": "metals-repo-tester",
  "version": "0.0.0",
  "author": "",
  "main": "app/build/index.js",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "mocha": "*",
    "typescript": "^5.9.3",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node app/build/index.js",
    "runWithBuilt": "npm run start -- --repos repos-bazel.json --out out-repos-bazel.txt --server-version 2.0.0-SNAPSHOT",
    "runIntellij": "npm run start -- --server intellij --repos repos-bazel.json --out repos-bazel-ij.txt"
  },
  "dependencies": {
    "vscode-uri": "^3.1.0"
  }
}
