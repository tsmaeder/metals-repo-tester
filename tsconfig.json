{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "rootDir": "app/src",
    "outDir": "app/build",
    "strict": false,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["app/src/**/*.ts"]
}
